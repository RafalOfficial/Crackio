# Crackio runs locally. Every variable here is optional — you can also paste keys in
# Settings → Connections (stored in data/settings.json on your machine).
# Keys saved in the app win over these environment variables.

# --- ComfyUI (the core of Crackio) -------------------------------------------
# Comfy Cloud: run every tool's workflow on cloud GPUs. https://platform.comfy.org
COMFY_API_KEY=
# Your own ComfyUI server (default http://127.0.0.1:8188)
COMFYUI_URL=

# --- Tuning ---------------------------------------------------------------------
# How many generations run at once (default 3)
# CRACKIO_CONCURRENCY=3
# Where generations, uploads and settings live (default ./data)
# CRACKIO_DATA_DIR=
# Where Director's depth and cutout models are kept (~220 MB, downloaded on first use;
# default ./data/models). Point it at another drive if this one is full.
# CRACKIO_MODELS_DIR=
