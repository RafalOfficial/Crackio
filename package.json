{
  "name": "crackio",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source AI studio for images and video. Stage the shot instead of guessing the prompt. Built on ComfyUI.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "studio": "next build && next start -p 3211",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "assets:generate": "node scripts/assets/generate.mjs",
    "assets:icons": "node scripts/assets/icons.mjs",
    "showcase:previews": "node scripts/assets/showcase-record.mjs"
  },
  "dependencies": {
    "@comfyorg/sdk": "^0.5.0",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "clsx": "^2.1.1",
    "ffmpeg-static": "5.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "nanoid": "^6.0.2",
    "next": "16.4.2",
    "onnxruntime-node": "1.30.0",
    "playwright-core": "1.56.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.15.1"
}
